NODE_ENV=development
PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hotspot_management_v2
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Optionnel : uniquement si vous utilisez un routeur MikroTik
# "par défaut" via l'environnement (hors flux normal, où les
# routeurs sont configurés dynamiquement depuis PostgreSQL).
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# Secret de signature des JWT. Générer avec :
#   openssl rand -hex 32
JWT_SECRET=change-me

# Clé de chiffrement AES-256-GCM (mots de passe MikroTik stockés
# en base). DOIT être une chaîne hexadécimale de 64 caractères
# (32 octets). Générer avec :
#   openssl rand -hex 32
# ATTENTION : si vous changez cette clé après avoir créé des
# routeurs, leurs mots de passe stockés deviennent illisibles.
CREDENTIALS_ENCRYPTION_KEY=change-me

# Optionnel. Intervalle (secondes) entre deux synchronisations
# automatiques des sessions actives MikroTik en tâche de fond.
# Mettre à 0 pour désactiver (utile en dev). Défaut : 30.
LIVE_SYNC_INTERVAL_SECONDS=30
